<Window x:Class="HangmanGame.Views.NewUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HangmanGame.ViewModels"
        Title="New User" Height="250" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:NewUserViewModel/>
    </Window.DataContext>

    <StackPanel Margin="15" VerticalAlignment="Center">

        <TextBlock Text="Username:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,15"/>

        <TextBlock Text="Image:" Margin="0,0,0,5"/>
        <DockPanel Margin="0,0,0,15">
            <Button Content="Browse..." 
                    Command="{Binding BrowseImageCommand}" 
                    DockPanel.Dock="Right" 
                    Width="75" Margin="5,0,0,0"/>
            <TextBox Text="{Binding ImagePath, Mode=TwoWay}" 
                     IsReadOnly="True"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="0,0,10,0" 
                    Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="75" 
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>