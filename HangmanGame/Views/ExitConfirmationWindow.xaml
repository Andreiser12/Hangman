<Window x:Class="HangmanGame.Views.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Game" Height="180" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Backgrounds/all_categories.jpg" 
                Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Are you sure you want to exit?&#x0a;Your current game will be lost."
                   FontSize="14"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
            <Button Content="Save" Width="100" Margin="5" 
                    Click="Save_Click" IsDefault="True"/>
            <Button Content="Don't Save" Width="100" Margin="5" 
                    Click="DontSave_Click"/>
            <Button Content="Cancel" Width="100" Margin="5" 
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>