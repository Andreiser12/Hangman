<Window x:Class="HangmanGame.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HangmanGame.ViewModels"
        xmlns:conv="clr-namespace:HangmanGame.Converters"
        mc:Ignorable="d"
        Title="Sign In" Height="500" Width="400"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:SignInViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:RelativePathToImageConverter x:Key="ImageConverter"/>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Backgrounds/all_categories.jpg" 
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Welcome to Hangman!"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Users}"
                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                 Margin="0,0,0,10"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Username}"
                               Foreground="Black"
                               FontSize="18"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&lt;&lt;"
                    Command="{Binding PreviousUserCommand}"
                    Width="40"
                    VerticalAlignment="Center"/>

            <Image Grid.Column="1"
                    Source="{Binding SelectedUser.ImagePath, Converter={StaticResource ImageConverter}}"
                    Height="120"
                   Stretch="Uniform"/>

            <Button Grid.Column="2"
                    Content="&gt;&gt;"
                    Command="{Binding NextUserCommand}"
                    Width="40"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="New User"
                    Command="{Binding NewUserCommand}"
                    Width="80"
                    Margin="5"/>
            <Button Content="Delete"
                    Command="{Binding DeleteUserCommand}"
                    Width="80"
                    Margin="5"/>
            <Button Content="Play"
                    Command="{Binding PlayCommand}"
                    Width="80"
                    Margin="5"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
