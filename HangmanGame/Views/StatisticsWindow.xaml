<Window x:Class="HangmanGame.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Backgrounds/all_categories.jpg" 
                Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Statistics for all users" 
                   FontSize="18" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1"
          ItemsSource="{Binding AllStatistics}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserSortColumns="True"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          Background="Transparent"
          RowBackground="#AAE8F0F5"
          AlternatingRowBackground="#80E8F0F5"
          BorderBrush="White"
          BorderThickness="1"
          FontSize="13">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#CCE8F0F5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="User" 
                            Binding="{Binding Username}" 
                            Width="*"/>
                <DataGridTextColumn Header="Category" 
                            Binding="{Binding Category}" 
                            Width="*"/>
                <DataGridTextColumn Header="Games Played" 
                            Binding="{Binding GamesPlayed}" 
                            Width="120"/>
                <DataGridTextColumn Header="Games Won" 
                            Binding="{Binding GamesWon}" 
                            Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" 
                Content="Close" 
                Width="75" 
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Click="CloseButton_Click" 
                IsCancel="True"/>
    </Grid>
</Window>