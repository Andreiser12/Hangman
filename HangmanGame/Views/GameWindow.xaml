<Window x:Class="HangmanGame.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HangmanGame.Converters"
        Title="Hangman Game" Height="600" Width="700">

    <Window.Resources>
        <conv:RelativePathToImageConverter x:Key="ImageConverter"/>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New Game" Click="NewGame_Click"/>
                <MenuItem Header="Open Game"/>
                <MenuItem Header="Save Game"/>
                <MenuItem Header="Statistics"/>
                <Separator/>
                <MenuItem Header="Cancel" Click="Cancel_Click"/>
            </MenuItem>
            <MenuItem Header="Categories" ItemsSource="{Binding Categories}"/>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rând 0: info jucător + timer -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Image Source="{Binding UserImagePath, Converter={StaticResource ImageConverter}}" 
                       Height="50" Width="50" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Username}" FontSize="18" 
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RemainingSeconds, StringFormat='Time: {0}s'}" 
                           FontSize="16" VerticalAlignment="Center" Margin="30,0,0,0"/>
                <TextBlock Text="{Binding CurrentLevel, StringFormat='Level: {0}/3'}" 
                           FontSize="16" VerticalAlignment="Center" Margin="30,0,0,0"/>
            </StackPanel>

            <!-- Rând 1: imagine spânzurătoare (placeholder) -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10">
                <TextBlock Text="Hangman Image Area" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" Foreground="Gray"/>
            </Border>

            <!-- Rând 2: butoane litere A-Z -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Letters}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Letter}" 
                                IsEnabled="{Binding IsEnabled}"
                                Command="{Binding DataContext.GuessLetterCommand, 
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Letter}"
                                Width="35" Height="35" Margin="2" FontSize="14"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rând 3: cuvântul de ghicit -->
            <TextBlock Grid.Row="3" Text="{Binding DisplayWord}" 
                       FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
        </Grid>
    </DockPanel>
</Window>