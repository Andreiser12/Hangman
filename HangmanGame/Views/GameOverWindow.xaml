<Window x:Class="HangmanGame.Views.GameOverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Over" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resources/Backgrounds/all_categories.jpg" 
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
           Text="{Binding Message}" 
           FontSize="36" FontWeight="Bold"
           Foreground="White"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextAlignment="Center"
           TextWrapping="Wrap">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Back to Sign In" 
                    Command="{Binding BackToSignInCommand}"
                    Width="150" Height="40"
                    HorizontalAlignment="Left"
                    FontSize="14"/>

            <Button Grid.Column="1" 
                    Content="Play Again" 
                    Command="{Binding PlayAgainCommand}"
                    Width="150" Height="40"
                    HorizontalAlignment="Right"
                    FontSize="14"/>
        </Grid>
    </Grid>
</Window>